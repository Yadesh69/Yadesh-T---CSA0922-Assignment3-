
class Examiner extends Thread {
    private int station;

    Examiner(int station) {
        this.station = station;
    }

    public void run() {
        System.out.println("Station " + station + " started");

        try {
            Thread.sleep(500);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }

        System.out.println("Station " + station + " completed 5 scripts");
    }
}

public class ThreadDemo {
    public static void main(String[] args) {
        Examiner[] examiners = new Examiner[4];

        for (int i = 0; i < 4; i++) {
            examiners[i] = new Examiner(i + 1);
            examiners[i].start();
        }

        for (Examiner examiner : examiners) {
            try {
                examiner.join();
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }

        System.out.println("Total scripts scanned: 20");
    }
}
